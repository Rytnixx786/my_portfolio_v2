# Portfolio v2 Environment Variables
# Copy this file to .env.local for local development and set secrets in Vercel Project Settings.

# Optional: Enables live Gemini-backed answers in the Ask Terminal (/api/query).
# When unset or rate-limited, /api/query automatically falls back to deterministic local search.
GEMINI_API_KEY=

# Optional: Canonical origin used for sitemaps, robots, and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://mehedi-hasan-llm.vercel.app

